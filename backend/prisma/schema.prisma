generator client {
  provider      = "prisma-client-js"
  // "native" covers local dev; "debian-openssl-3.0.x" is the Docker runtime
  // (node:20-slim / Debian bookworm). Listing it explicitly ensures the correct
  // query engine is generated even if openssl version detection fails at build.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = "file:../data/database/database.db"
}

/// A fake-IdP user. NOTE: this is a test/simulator IdP, so `password` is stored
/// in plain text on purpose — the IdP must be able to replay credentials.
model User {
  id                      String                    @id @default(cuid())
  name                    String
  username                String
  password                String
  attributes              Attribute[]
  groups                  Group[]
  legacyApplicationAccess LegacyApplicationAccess[]
}

/// A documented SAML group. Membership is relational; the legacy comma-separated
/// `groups` claim is produced only at the SAML and users.js boundaries.
model Group {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  description  String        @default("")
  users        User[]
  applications Application[]
}

/// Ansluten testapplikation. Grupper ger access till noll eller flera
/// applikationer; en användares applikationer härleds från gruppmedlemskapen.
/// LegacyApplicationAccess bevarar äldre direkttilldelningar tills de har
/// klassificerats uttryckligen. Metadata blir aldrig ett SAML-claim.
model Application {
  id                      Int                       @id @default(autoincrement())
  name                    String                    @unique
  description             String                    @default("")
  groups                  Group[]
  legacyApplicationAccess LegacyApplicationAccess[]
  oidcClients             OidcClient[]
}

/// Compatibility owner for persisted per-user assignments created before
/// application access moved to Group. Writes are limited to legacy users.js
/// imports and the deprecated applicationIds API adapter. Remove this model only
/// after those adapters are retired and the mapped table is verified empty.
model LegacyApplicationAccess {
  applicationId Int         @map("A")
  userId        String      @map("B")
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([applicationId, userId], map: "_ApplicationToUser_AB_unique")
  @@index([userId], map: "_ApplicationToUser_B_index")
  @@map("_ApplicationToUser")
}

/// A single SAML attribute belonging to a user. Keys are free-form (e.g.
/// `givenName`, `email`, `urn:oid:0.9.2342.19200300.100.1.1`) and may
/// repeat across users with different casing, so no uniqueness is enforced here.
model Attribute {
  id     Int    @id @default(autoincrement())
  userId String
  key    String
  format String
  value  String
  type   String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// An OIDC Relying Party registered with the fake IdP. SAML needs no registration
/// here — an AuthnRequest carries its own AssertionConsumerServiceURL — but OIDC
/// has no signed request to lean on, so exact-match `redirectUris` IS the security
/// boundary. `clientSecret` is plaintext for the same reason `User.password` is:
/// this is a test/simulator IdP and the operator must be able to read it back.
model OidcClient {
  id                     Int          @id @default(autoincrement())
  /// Public identifier the RP sends as `client_id`.
  clientId               String       @unique
  /// Empty for public clients (PKCE-only, no client authentication).
  clientSecret           String       @default("")
  name                   String
  description            String       @default("")
  /// JSON array of exact-match redirect URIs. SQLite has no scalar list type, so
  /// the list is stored encoded and parsed at the store boundary.
  redirectUris           String       @default("[]")
  /// JSON array, same encoding. Used by RP-initiated logout (`end_session`).
  postLogoutRedirectUris String       @default("[]")
  /// Public clients MUST use PKCE; confidential ones may opt out for older RPs.
  requirePkce            Boolean      @default(true)
  /// Public clients authenticate with PKCE alone and hold no usable secret.
  isPublic               Boolean      @default(false)
  /// Optional link to the tool-metadata Application, so a registered RP shows up
  /// in the same access view as the SAML-side test applications.
  applicationId          Int?
  application            Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([applicationId])
}
