{
  "name": "backend",
  "version": "0.0.1",
  "description": "TypeScript + Express + Routing Controllers API Server",
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=24 <25"
  },
  "prisma": {
    "seed": "cross-env NODE_ENV=development ts-node --transpile-only prisma/seed.ts"
  },
  "scripts": {
    "start": "cross-env NODE_ENV=production node dist/server.js",
    "dev": "cross-env NODE_ENV=development nodemon",
    "generate:contracts": "cross-env NODE_ENV=development ts-node ./src/swagger-typescript-api.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "cross-env NODE_ENV=development prisma migrate dev",
    "prisma:seed": "cross-env NODE_ENV=development ts-node --transpile-only prisma/seed.ts",
    "create-admin": "cross-env NODE_ENV=development ts-node --transpile-only prisma/create-admin.ts",
    "build": "tsc && tsc-alias",
    "build:swc": "swc src -d dist --source-maps --copy-files",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "lint:fix": "npm run lint -- --fix",
    "deploy:prod": "npm run build && pm2 start ecosystem.config.js --only prod",
    "deploy:dev": "pm2 start ecosystem.config.js --only dev",
    "type-check": "tsc --pretty --noEmit && tsc -p tsconfig.vitest.json --pretty --noEmit"
  },
  "dependencies": {
    "@node-saml/passport-saml": "^5.1.0",
    "@prisma/client": "6.19.3",
    "@xmldom/xmldom": "^0.8.14",
    "axios": "^1.19.0",
    "body-parser": "^1.20.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "class-validator-jsonschema": "^5.1.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "envalid": "^8.2.0",
    "express": "^4.22.2",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "memorystore": "^1.6.8",
    "morgan": "^1.11.0",
    "passport": "^0.7.0",
    "reflect-metadata": "^0.2.2",
    "routing-controllers": "^0.11.3",
    "routing-controllers-openapi": "^4.0.0",
    "session-file-store": "^1.5.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "xml-crypto": "^6.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@swc/cli": "0.8.1",
    "@swc/core": "^1.16.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/express-session": "^1.19.0",
    "@types/hpp": "^0.2.7",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.13.3",
    "@types/passport": "^1.0.17",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.7",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "prisma": "6.19.3",
    "supertest": "^7.2.2",
    "swagger-typescript-api": "^13.12.6",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.67.0",
    "@vitest/coverage-v8": "4.1.10",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "resolutions": {
    "@swc/cli/**/brace-expansion": "2.1.4",
    "@swc/cli/minimatch": "9.0.7",
    "@swc/cli/piscina": "4.9.3",
    "@types/express": "4.17.25",
    "@types/express-serve-static-core": "4.19.9",
    "**/@xmldom/xmldom": "0.8.14",
    "routing-controllers/**/@babel/core": "7.29.7",
    "routing-controllers/body-parser": "1.20.6",
    "express/body-parser": "1.20.6",
    "routing-controllers/express/body-parser": "1.20.6",
    "routing-controllers/glob/minimatch/brace-expansion": "5.0.9",
    "express/path-to-regexp": "0.1.13",
    "routing-controllers/express/path-to-regexp": "0.1.13",
    "session-file-store/**/bn.js": "4.12.3",
    "hpp/lodash": "4.18.1",
    "routing-controllers-openapi/openapi3-ts/yaml": "1.10.3",
    "class-validator-jsonschema/openapi3-ts/yaml": "2.8.3",
    "eslint/**/brace-expansion": "1.1.18",
    "eslint/**/flatted": "3.4.2",
    "lint-staged/**/picomatch": "2.3.2",
    "nodemon/**/picomatch": "2.3.2",
    "qs": ">=6.15.3",
    "form-data": ">=4.0.6",
    "multer": ">=2.2.0",
    "swagger-typescript-api/**/js-yaml": "4.3.1",
    "swagger-typescript-api/swagger2openapi/yaml": "1.10.3",
    "swagger-typescript-api/swagger2openapi/oas-resolver/yaml": "1.10.3",
    "swagger-typescript-api/swagger2openapi/oas-validator/oas-resolver/yaml": "1.10.3",
    "tsc-alias/**/picomatch": "2.3.2",
    "ts-node/diff": "4.0.4",
    "typescript-eslint/**/picomatch": "4.0.4",
    "vitest/**/picomatch": "4.0.4"
  }
}
