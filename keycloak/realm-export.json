{
  "realm": "kommuninvanare",
  "displayName": "Kommuninvånare — Sundsvalls kommun",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": true,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,

  "identityProviders": [
    {
      "alias": "fake-idp",
      "displayName": "Fake IdP (simulerar Mobility Guard / BankID)",
      "providerId": "saml",
      "enabled": true,
      "updateProfileFirstLoginMode": "off",
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "authenticateByDefault": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "singleSignOnServiceUrl": "http://localhost:7001/api/saml/idp/sso",
        "singleLogoutServiceUrl": "http://localhost:7001/api/saml/idp/logout",
        "nameIDPolicyFormat": "urn:oasis:names:tc:SAML:1.1:nameid-format:unspecified",
        "principalType": "SUBJECT",
        "signatureAlgorithm": "RSA_SHA256",
        "postBindingAuthnRequest": "false",
        "postBindingResponse": "true",
        "postBindingLogout": "false",
        "wantAuthnRequestsSigned": "false",
        "wantAssertionsSigned": "true",
        "wantAssertionsEncrypted": "false",
        "validateSignature": "true",
        "signingCertificate": "",
        "allowCreate": "true",
        "syncMode": "IMPORT"
      }
    }
  ],

  "identityProviderMappers": [
    {
      "name": "email",
      "identityProviderAlias": "fake-idp",
      "identityProviderMapper": "saml-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "attribute.name": "email",
        "user.attribute": "email"
      }
    },
    {
      "name": "given-name",
      "identityProviderAlias": "fake-idp",
      "identityProviderMapper": "saml-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "attribute.name": "givenName",
        "user.attribute": "firstName"
      }
    },
    {
      "name": "surname",
      "identityProviderAlias": "fake-idp",
      "identityProviderMapper": "saml-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "attribute.name": "surname",
        "user.attribute": "lastName"
      }
    },
    {
      "name": "citizenIdentifier",
      "identityProviderAlias": "fake-idp",
      "identityProviderMapper": "saml-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "attribute.name": "citizenIdentifier",
        "user.attribute": "citizenIdentifier"
      }
    },
    {
      "name": "username",
      "identityProviderAlias": "fake-idp",
      "identityProviderMapper": "saml-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "attribute.name": "username",
        "user.attribute": "username"
      }
    },
    {
      "name": "groups",
      "identityProviderAlias": "fake-idp",
      "identityProviderMapper": "saml-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "attribute.name": "groups",
        "user.attribute": "groups"
      }
    }
  ],

  "clients": [
    {
      "clientId": "citizen-app",
      "name": "Medborgarportalen (test)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:7090/*"],
      "webOrigins": ["http://localhost:7090"],
      "protocol": "openid-connect",
      "attributes": { "pkce.code.challenge.method": "S256" },
      "defaultClientScopes": ["citizen-attributes"],
      "optionalClientScopes": []
    },
    {
      "clientId": "local-test-client",
      "name": "Local Test Client",
      "description": "Dev OIDC-klient — byt ut mot riktiga klienter i Keycloak-admin",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["*"],
      "webOrigins": ["*"],
      "protocol": "openid-connect"
    }
  ],

  "clientScopes": [
    {
      "name": "citizen-attributes",
      "description": "Sundsvall-specifika SAML-attribut från fake-IdP / Mobility Guard",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "citizenIdentifier",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "citizenIdentifier",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "citizenIdentifier",
            "jsonType.label": "String"
          }
        },
        {
          "name": "groups-claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "groups",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "groups",
            "jsonType.label": "String"
          }
        },
        {
          "name": "username-claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "username",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "municipalityUsername",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ],

  "defaultDefaultClientScopes": [
    "citizen-attributes"
  ]
}
