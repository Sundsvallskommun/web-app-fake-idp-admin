{
  "name": "@sk-web-gui/web-app-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "dotenv next dev",
    "build": "dotenv next build",
    "start": "dotenv next start",
    "generate:contracts": "cross-env NODE_ENV=development npx tsx ./src/swagger-typescript-api.ts",
    "lint": "eslint .",
    "type-check": "tsc --pretty --noEmit --incremental false && tsc -p tsconfig.vitest.json --pretty --noEmit --incremental false",
    "analyze": "cross-env ANALYZE=true next build",
    "analyze:server": "cross-env BUNDLE_ANALYZE=server next build",
    "analyze:browser": "cross-env BUNDLE_ANALYZE=browser next build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@next/bundle-analyzer": "16.3.1",
    "@sk-web-gui/core": "4.6.1",
    "@sk-web-gui/react": "3.1.2",
    "axios": "^1.19.0",
    "dayjs": "^1.11.22",
    "dotenv-cli": "^8.0.0",
    "i18next": "^24.2.3",
    "lucide-react": "0.576.0",
    "next": "16.3.1",
    "next-i18next": "^15.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "react-i18next": "^15.7.4",
    "sass": "^1.102.0",
    "sharp": "0.35.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "autoprefixer": "^10.5.4",
    "cross-env": "^7.0.3",
    "envalid": "^8.2.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "jsdom": "30.0.1",
    "postcss": "^8.5.26",
    "postcss-import": "^16.2.0",
    "postcss-nested": "^7.0.2",
    "postcss-nesting": "^13.0.2",
    "prettier": "^3.9.6",
    "swagger-typescript-api": "^13.12.6",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "@vitest/coverage-v8": "4.1.10",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "browserslist": [
    "defaults and fully supports es6-module",
    "maintained node versions"
  ],
  "resolutions": {
    "**/@babel/runtime": "7.29.7",
    "@next/bundle-analyzer/**/ws": "7.5.11",
    "@sk-web-gui/core/**/glob": "10.5.0",
    "@sk-web-gui/core/**/nanoid": "3.3.18",
    "@sk-web-gui/core/**/picomatch": "2.3.2",
    "@sk-web-gui/core/**/postcss": "8.5.26",
    "@sk-web-gui/core/**/yaml": "2.8.3",
    "eslint/**/brace-expansion": "1.1.18",
    "eslint/**/flatted": "3.4.2",
    "eslint-config-next/eslint-plugin-import/minimatch": "3.1.4",
    "swagger-typescript-api/**/js-yaml": "4.3.1",
    "swagger-typescript-api/swagger2openapi/yaml": "1.10.3",
    "swagger-typescript-api/swagger2openapi/oas-resolver/yaml": "1.10.3",
    "swagger-typescript-api/swagger2openapi/oas-validator/oas-resolver/yaml": "1.10.3",
    "vitest/**/picomatch": "4.0.4",
    "next-i18next/i18next-fs-backend": "2.6.7"
  }
}
